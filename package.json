{
  "name": "fantasybot",
  "version": "0.1.0",
  "private": true,
  "description": "Autopilot assistant for an ESPN fantasy football league. Recommends lineup/waiver/trade moves via Telegram; human taps Approve/Reject.",
  "type": "module",
  "scripts": {
    "bot:run": "tsx bot/run.ts",
    "espn:test": "tsx bot/espn/client.ts",
