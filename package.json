    "tool": "tsx bot/tools/cli.ts",
    "state:pull": "tsx bot/tools/state-sync.ts pull",
    "state:push": "tsx bot/tools/state-sync.ts push"
  },
  "dependencies": {
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
